# ---------- backend (.env na raiz) ----------
DATABASE_URL=postgresql://postgres:postgres@localhost:55432/nota_a_nota
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=

MODELO_CATEGORIZACAO=claude-haiku-5-5
MODELO_ANALISE=claude-haiku-5-5
MODELO_EMBEDDING=voyage-4-lite
ESFORCO_CHAT=low

# Conexões por instância da API. Some todas as instâncias da API e do front e mantenha abaixo do
# max_connections do Postgres (25 no db-f1-micro do Cloud SQL, com 3 reservadas).
DB_POOL_SIZE=2
DB_MAX_OVERFLOW=3

# Pesquisa de estabelecimentos na revisão de "Outros": "anthropic" usa a ferramenta de busca
# na web da API da Anthropic (cobrada por busca; precisa estar liberada no Console). Vazio desliga.
PESQUISA_WEB=
PESQUISA_WEB_MAX_POR_MENSAGEM=3

# De onde vem a chave pública que assina os JWTs do front (Better Auth).
AUTH_JWKS_URL=http://localhost:3100/api/auth/jwks
AUTH_ISSUER=http://localhost:3100
AUTH_AUDIENCE=nota-a-nota-api

# ---------- frontend (frontend/.env.local) ----------
# Sem NOTA_API_URL, BETTER_AUTH_SECRET e DATABASE_URL o front só mostra /demonstracao.
NOTA_API_URL=http://localhost:8100
# Endereço do MCP mostrado em Conta, se for diferente do NOTA_API_URL interno.
NOTA_API_URL_PUBLICA=

# Gere com: openssl rand -base64 48
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3100
DATABASE_URL=postgresql://postgres:postgres@localhost:55432/nota_a_nota
AUTH_AUDIENCE=nota-a-nota-api

# E-mail (local: Mailpit do docker-compose, caixa em http://localhost:8025).
SMTP_URL=smtp://localhost:1025
EMAIL_REMETENTE=Capi <nao-responda@capi.localhost>

# Google (opcional; sem as duas o botão some).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Atrás de proxy/CDN: IPs ou faixas dos proxies confiáveis, separados por vírgula.
AUTH_TRUSTED_PROXIES=
AUTH_IP_HEADERS=
# false desliga a checagem de senha vazada no Have I Been Pwned.
VERIFICAR_SENHA_VAZADA=true
